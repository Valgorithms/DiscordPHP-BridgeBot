<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnDeprecation="true">
    <testsuites>
        <testsuite name="BridgeBot">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <!--
        This repository's own code. A deprecation raised inside vendor/ is that
        package's to fix, and is not reported here: react/dns raises one on any
        Windows without wmic, which includes GitHub's runners.
    -->
    <source ignoreIndirectDeprecations="true">
        <include>
            <file>bot.php</file>
            <directory>tests</directory>
        </include>
    </source>
</phpunit>
