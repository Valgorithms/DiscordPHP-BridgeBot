# Copy to .env and fill in. Never commit the result.
#
# A connector is installed only when its credentials are here, so filling in
# one section and leaving the other empty is a supported way to run: the bot
# says which it skipped and starts anyway.

# ── Discord ────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → Bot → Token
#
# Use a DEDICATED application. Slash commands are registered per application,
# so sharing a token with another bot that also defines /twitch or /telegram
# means whichever boots first wins and the other silently skips registering —
# no error, nothing in the log.
DISCORD_TOKEN=

# Enable the MESSAGE CONTENT intent on that page, or every relayed message
# arrives empty and no prefix command is ever recognised. Slash commands keep
# working without it; the relay does not.

# Optional, and the safe default is to leave it empty. This identity gates the
# operator-only commands — `/twitch api` reaches every Helix endpoint with the
# bot's own token, and can ban users, end streams and rewrite a channel.
#
# It is also who gets a DM when a bridge breaks, when the configuration file
# cannot be read, or when Twitch needs re-authorizing. Without it, those only
# reach the log.
DISCORD_OWNER_ID=

# Optional. What the bot answers to for prefix commands on Discord.
DISCORD_PREFIX=!

# Optional. The name the relay creates its webhooks under.
WEBHOOK_NAME=Bridge

# debug | info | notice | warning | error
LOG_LEVEL=info

# ── Twitch ─────────────────────────────────────────────────────────────
# Leave TWITCH_CLIENT_ID and TWITCH_NICK empty to run without Twitch.
TWITCH_CLIENT_ID=

# Optional. Without it the bot runs and relays, but cannot REFRESH its access
# token: `OAuth::form()` refuses every grant except device-code when no secret
# is set. Roughly four hours in, it will ask for a device code instead, DM'd to
# DISCORD_OWNER_ID. Set a secret for unattended operation.
TWITCH_CLIENT_SECRET=

# The account the bot speaks as in Twitch chat.
TWITCH_NICK=

# A user token for that account (chat:read and chat:edit), and its refresh
# token. The bot rewrites both here when Twitch rotates them — Twitch
# invalidates the old refresh token on every rotation, so anything that does
# not persist the new pair locks itself out on the next restart. For the same
# reason, do not share one pair with another project: whichever refreshes first
# breaks the other's copy.
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# Optional. Who may run `/twitch api` from Twitch chat. Same gate as
# DISCORD_OWNER_ID, for the other surface; unset means unreachable from there.
TWITCH_OWNER_LOGIN=

# Optional. What the bot answers to in Twitch chat — separate from Discord's,
# because another bot may already own `!` in one of the two.
TWITCH_PREFIX=!

# ── Telegram ───────────────────────────────────────────────────────────
# Talk to @BotFather → /newbot, then copy the token. Leave empty to run
# without Telegram.
#
# Two settings on the bot matter for a bridge:
#
#   /setprivacy → Disable
#       Privacy mode is ON by default, and a bot with it on only receives
#       commands and replies aimed at it — every ordinary group message is
#       invisible to it, so the bridge relays nothing. This is the single most
#       common reason a new bridge looks dead in one direction.
#
#   Add the bot to the group, and promote it if you want pin, ban or the
#       invite link to work. Reading and sending need no rank.
TELEGRAM_TOKEN=

# Optional, and usually needed on Windows: a PHP build there typically ships
# without a CA bundle, so TLS to api.telegram.org fails with "unable to get
# local issuer certificate". Point this at a cacert.pem. Ignored when empty.
TELEGRAM_CA_BUNDLE=

# Optional. Point the bridge at a local Bot API server, which raises the upload
# limit and lets it download files larger than 20 MB.
# https://core.telegram.org/bots/api#using-a-local-bot-api-server
TELEGRAM_BASE_URL=

# Optional. Seconds between long polls. Floored at 0.5.
TELEGRAM_POLL_INTERVAL=1.0
